# Copy to .env for local runs. .env is gitignored; .env.example is committed.

# Base URL of the ASP.NET Core backend the agents call back into.
BACKEND_BASE_URL=http://localhost:5067

# Shared secret for the backend's /api/internal/* endpoints.
# Must match "InternalAgentSecret" in the backend's appsettings.Development.json.
INTERNAL_AGENT_SECRET=dev-only-local-secret-value-12345
